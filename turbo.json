{
    "$schema": "https://turbo.build/schema.json",
    "tasks": {
        "db:generate": {
            "cache": false
        },
        "build": {
            "dependsOn": ["^build", "db:generate"],
            "outputs": ["dist/**", "src/generated/**"]
        },
        "lint": {
            "dependsOn": ["^lint"]
        },
        "check-types": {
            "dependsOn": ["^build", "build"]
        },
        "test": {
            "dependsOn": ["^build"],
            "outputs": ["coverage/**"]
        },
        "dev": {
            "cache": false,
            "persistent": true
        }
    }
}
